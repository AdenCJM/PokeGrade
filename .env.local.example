# Copy this file to .env.local and fill in your key.
#   cp .env.local.example .env.local
#
# Both the Next web app and the Python engine read this file (the engine loads
# it from the repo root), so the key lives in one place.

# Required for real grading: your Anthropic API key
# (https://console.anthropic.com/settings/keys). Used by the engine's
# soft-pillar adjudicator. Without it, the engine still measures centering and
# returns a verdict, but corners/edges/surface route to an in-hand check.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the adjudicator model.
#   claude-opus-4-8     (default) most accurate visual reasoning, slower (~15-40s)
#   claude-sonnet-4-6   faster, cheaper, slightly less careful
MODEL=claude-opus-4-8

# Optional: where the Next route reaches the FastAPI engine. The default is
# right for `npm run dev`, which starts the engine on 127.0.0.1:8000 next to
# Next. Point it at a hosted engine to grade from a deployed front end.
# ENGINE_URL=http://127.0.0.1:8000

# Deployed builds (Vercel) are demo-only unless BOTH of these are set. Every
# live grade is a paid Claude call, so a public URL must never grade by
# accident. Rate limiting and auth in front of the proxy are v2 scope; do not
# turn this on for a public URL without them.
# LIVE_GRADING=1
# ENGINE_SHARED_SECRET=...   # sent to the engine as Authorization: Bearer
