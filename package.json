{
  "name": "pokegrade",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n engine,web -c blue,green \"npm:dev:engine\" \"npm:dev:web\"",
    "dev:lan": "concurrently -k -n engine,web -c blue,green \"npm:dev:engine\" \"npm:dev:web:lan\"",
    "dev:engine": "uv run --project engine uvicorn pokegrade.app:app --host 127.0.0.1 --port 8000 --reload --reload-dir engine/pokegrade",
    "dev:web": "next dev",
    "dev:web:lan": "next dev -H 0.0.0.0 -p 3000",
    "engine:test": "uv run --project engine pytest -q",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  }
}
