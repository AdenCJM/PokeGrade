{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pokegrade",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "pokegrade-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web",
        "--",
        "-p",
        "3001"
      ],
      "port": 3001
    }
  ]
}
